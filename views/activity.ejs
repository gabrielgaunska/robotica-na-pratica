<%- include('partials/header') %>
<div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border border-slate-200">
  <div class="mb-6">
    <a href="/" class="text-indigo-600 font-semibold hover:underline text-sm mb-4 inline-block">← Voltar para o início</a>
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full uppercase"><%= activity.category %></span>
      <% if (activity.age_range) { %> <span class="bg-slate-100 text-slate-700 text-xs font-medium px-3 py-1 rounded-full">Faixa Etária: <%= activity.age_range %></span> <% } %>
      <% if (activity.duration) { %> <span class="bg-slate-100 text-slate-700 text-xs font-medium px-3 py-1 rounded-full">Duração: <%= activity.duration %></span> <% } %>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900"><%= activity.title %></h1>
  </div>

  <% if (activity.image) { %>
    <div class="mb-8 rounded-2xl overflow-hidden shadow-md border border-slate-200 max-h-[450px]">
      <img src="<%= activity.image %>" alt="<%= activity.title %>" class="w-full h-full object-cover">
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
    <div class="lg:col-span-2">
      <h2 class="text-xl font-bold text-slate-800 mb-3 border-b pb-2">🎯 Objetivo e Descrição</h2>
      <p class="text-slate-700 leading-relaxed text-base sm:text-lg mb-6"><%= activity.description %></p>

      <h2 class="text-2xl font-bold text-slate-800 mb-4 border-b pb-2">🛠️ Materiais Necessários</h2>
      <div class="bg-amber-50 border border-amber-200 p-4 rounded-xl mb-6 text-slate-800 font-medium whitespace-pre-line text-base"><%= activity.materials %></div>

      <% if (activity.safety) { %>
        <h2 class="text-xl font-bold text-red-700 mb-2">⚠️ Dicas de Segurança</h2>
        <div class="bg-red-50 border border-red-200 p-4 rounded-xl mb-6 text-red-900 text-sm whitespace-pre-line"><%= activity.safety %></div>
      <% } %>
    </div>
  </div>

  <!-- PASSO A PASSO COM IMAGEM BEM GRANDE LADO A LADO -->
  <div class="border-t pt-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-6">📋 Passo a Passo da Montagem</h2>
    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
      <div class="prose max-w-none text-slate-800 whitespace-pre-line text-lg leading-relaxed font-normal">
        <%= activity.steps %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
