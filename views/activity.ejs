<%- include('partials/header') %>

<div class="max-w-3xl mx-auto">
  <a href="/" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 mb-6">
    &larr; Voltar para as atividades
  </a>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <% if (activity.image) { %>
      <img src="<%= activity.image %>" alt="<%= activity.title %>" class="w-full h-64 sm:h-96 object-cover">
    <% } %>

    <div class="p-6 sm:p-10">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800">
          <%= activity.category %>
        </span>
        <% if (activity.age_range) { %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
            <%= activity.age_range %>
          </span>
        <% } %>
        <% if (activity.duration) { %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
            ⏱️ <%= activity.duration %>
          </span>
        <% } %>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-4"><%= activity.title %></h1>
      <p class="text-lg text-gray-600 mb-8"><%= activity.description %></p>

      <div class="border-t border-gray-100 pt-8 mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">📦 Materiais Necessários</h2>
        <div class="bg-gray-50 rounded-xl p-6 text-gray-700 whitespace-pre-line leading-relaxed"><%= activity.materials %></div>
      </div>

      <!-- EXIBIÇÃO VISUAL DO PASSO A PASSO -->
      <div class="border-t border-gray-100 pt-8 mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6">🚀 Passo a Passo Ilustrado</h2>
        
        <div class="space-y-8">
          <% 
            let parsedSteps = [];
            try {
              parsedSteps = JSON.parse(activity.steps);
            } catch(e) {
              parsedSteps = [];
            }
          %>
          
          <% if (parsedSteps.length === 0) { %>
            <p class="text-gray-500 bg-gray-50 p-6 rounded-xl">Nenhum passo cadastrado para esta atividade.</p>
          <% } else { %>
            <% parsedSteps.forEach((step, idx) => { %>
              <div class="flex flex-col md:flex-row gap-6 items-start bg-gray-50 p-6 rounded-2xl border border-gray-100">
                <div class="flex-grow">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-indigo-600 text-white mb-3">
                    ETAPA <%= idx + 1 %>
                  </span>
                  <p class="text-gray-700 text-base leading-relaxed whitespace-pre-line"><%= step.text %></p>
                </div>
                
                <% if (step.image) { %>
                  <div class="w-full md:w-64 flex-shrink-0">
                    <img src="<%= step.image %>" alt="Imagem da Etapa <%= idx + 1 %>" class="w-full h-40 object-cover rounded-xl border border-gray-200 shadow-sm">
                  </div>
                <% } %>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <% if (activity.safety) { %>
        <div class="border-t border-gray-100 pt-8">
          <div class="bg-red-50 rounded-xl p-6 border border-red-100">
            <h2 class="text-lg font-bold text-red-800 mb-2">⚠️ Instruções de Segurança</h2>
            <p class="text-red-700 leading-relaxed text-sm"><%= activity.safety %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
