<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 py-12">
  <a href="/" class="text-blue-600 hover:text-blue-800 font-medium inline-flex items-center gap-1 mb-6">
    &larr; Voltar para a página inicial
  </a>

  <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
    <% if (activity.image) { %>
      <img src="<%= activity.image %>" class="w-full h-96 object-cover" alt="<%= activity.title %>">
    <% } %>

    <div class="p-8">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 mb-4">
        <%= activity.category %>
      </span>

      <h1 class="text-3xl font-extrabold text-slate-900 mb-4"><%= activity.title %></h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 bg-slate-50 p-4 rounded-xl border border-slate-100">
        <% if (activity.age_range) { %>
          <div>
            <span class="text-xs text-slate-500 block uppercase font-bold tracking-wider">Faixa Etária</span>
            <span class="text-slate-800 font-medium"><%= activity.age_range %></span>
          </div>
        <% } %>
        <% if (activity.duration) { %>
          <div>
            <span class="text-xs text-slate-500 block uppercase font-bold tracking-wider">Tempo Estimado</span>
            <span class="text-slate-800 font-medium"><%= activity.duration %></span>
          </div>
        <% } %>
      </div>

      <div class="space-y-6">
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Descrição e Objetivo</h3>
          <p class="text-slate-700 leading-relaxed"><%= activity.description %></p>
        </div>

        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Materiais Necessários</h3>
          <p class="text-slate-700 whitespace-pre-line leading-relaxed"><%= activity.materials %></p>
        </div>

        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Passo a Passo de Montagem</h3>
          <p class="text-slate-700 whitespace-pre-line leading-relaxed"><%= activity.steps %></p>
        </div>

        <% if (activity.safety) { %>
          <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl">
            <h4 class="font-bold text-amber-800 mb-1">Dicas de Segurança</h4>
            <p class="text-amber-700 text-sm leading-relaxed"><%= activity.safety %></p>
          </div>
        <% } %>
      </div>
    </div>
  </article>
</div>

<%- include('partials/footer') %>
