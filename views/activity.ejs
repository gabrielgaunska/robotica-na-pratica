<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 py-12">
  <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center gap-1 mb-8 group transition">
    <span class="group-hover:-translate-x-1 transition-transform">&larr;</span> Voltar para as atividades
  </a>

  <article class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-lg">
    <% if (activity.image) { %>
      <div class="relative h-96 w-full">
        <img src="<%= activity.image %>" class="w-full h-full object-cover" alt="<%= activity.title %>">
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
      </div>
    <% } %>

    <div class="p-8 md:p-12">
      <!-- Categoria -->
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-blue-50 text-blue-600 border border-blue-100 mb-6">
        🚀 <%= activity.category %>
      </span>

      <!-- Título -->
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 leading-tight mb-6"><%= activity.title %></h1>

      <!-- Informações Práticas -->
      <div class="grid grid-cols-2 gap-6 p-6 bg-slate-50 rounded-2xl border border-slate-100 mb-8">
        <% if (activity.age_range) { %>
          <div>
            <span class="text-xs text-slate-400 uppercase font-bold tracking-wider">👥 Faixa Etária</span>
            <span class="text-lg font-bold text-slate-800 block mt-0.5"><%= activity.age_range %></span>
          </div>
        <% } %>
        <% if (activity.duration) { %>
          <div>
            <span class="text-xs text-slate-400 uppercase font-bold tracking-wider">⏱️ Tempo Estimado</span>
            <span class="text-lg font-bold text-slate-800 block mt-0.5"><%= activity.duration %></span>
          </div>
        <% } %>
      </div>

      <!-- Conteúdo Principal -->
      <div class="space-y-10">
        <!-- Descrição -->
        <div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3 flex items-center gap-2"><span>📝</span> Objetivo</h3>
          <p class="text-slate-600 leading-relaxed text-lg"><%= activity.description %></p>
        </div>

        <!-- Materiais -->
        <div class="bg-blue-50/50 p-8 rounded-3xl border border-blue-100/50">
          <h3 class="text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2"><span>📦</span> Materiais Necessários</h3>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-slate-700">
            <% activity.materials.split('\n').forEach(function(material) { %>
              <% if (material.trim()) { %>
                <li class="flex items-center gap-2 text-base font-medium">
                  <span class="text-blue-500">✔</span> <%= material.replace(/^-\s*/, '') %>
                </li>
              <% } %>
            <% }); %>
          </ul>
        </div>

        <!-- Passos de Montagem -->
        <div>
          <h3 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2"><span>🛠️</span> Passo a Passo de Montagem</h3>
          <div class="space-y-6">
            <% const stepsList = activity.steps.split('|||'); %>
            <% stepsList.forEach(function(step, index) { %>
              <% if (step.trim()) { %>
                <div class="flex gap-4 p-5 bg-white border border-slate-150 rounded-2xl hover:border-blue-200 transition">
                  <span class="bg-gradient-to-br from-blue-500 to-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-base shrink-0 shadow-md">
                    <%= index + 1 %>
                  </span>
                  <div class="pt-1">
                    <p class="text-slate-700 leading-relaxed text-lg"><%= step %></p>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        </div>

        <!-- Segurança -->
        <% if (activity.safety) { %>
          <div class="bg-amber-50 border-2 border-amber-200 p-6 rounded-3xl flex gap-4 items-start">
            <span class="text-3xl">⚠️</span>
            <div>
              <h4 class="font-extrabold text-amber-900 text-lg mb-1">Dicas Importantes de Segurança</h4>
              <p class="text-amber-800 leading-relaxed"><%= activity.safety %></p>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </article>
</div>

<%- include('partials/footer') %>
