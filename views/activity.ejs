<%- include('partials/header') %>

<a href="/" class="inline-block mb-6 text-indigo-600 font-bold hover:underline">← Voltar para o início</a>

<article class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
  <span class="text-xs font-bold px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full inline-block mb-3">
    <%= activity.category %>
  </span>
  <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4"><%= activity.title %></h1>

  <div class="flex flex-wrap gap-4 text-sm text-slate-600 mb-6 border-b border-slate-100 pb-4">
    <% if (activity.age_range) { %>
      <div><strong>Faixa etária:</strong> <%= activity.age_range %></div>
    <% } %>
    <% if (activity.duration) { %>
      <div><strong>Tempo estimado:</strong> <%= activity.duration %></div>
    <% } %>
  </div>

  <% if (activity.image) { %>
    <div class="mb-8 rounded-2xl overflow-hidden border border-slate-200 shadow-sm max-h-[450px]">
      <img src="<%= activity.image %>" alt="<%= activity.title %>" class="w-full h-full object-cover">
    </div>
  <% } %>

  <div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Objetivo e Descrição</h2>
    <p class="text-slate-700 leading-relaxed text-lg"><%= activity.description %></p>
  </div>

  <div class="mb-8 bg-amber-50 border border-amber-200 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-amber-900 mb-3 flex items-center gap-2">🛠️ Materiais Necessários</h2>
    <div class="text-amber-800 whitespace-pre-line leading-relaxed text-base"><%= activity.materials %></div>
  </div>

  <% if (activity.safety) { %>
    <div class="mb-8 bg-red-50 border border-red-200 rounded-2xl p-6">
      <h2 class="text-xl font-bold text-red-900 mb-2 flex items-center gap-2">⚠️ Orientações de Segurança</h2>
      <p class="text-red-800 text-base"><%= activity.safety %></p>
    </div>
  <% } %>

  <div>
    <h2 class="text-2xl font-bold text-slate-900 mb-6">Passo a Passo da Montagem</h2>
    
    <% 
      let stepList = [];
      try {
        stepList = JSON.parse(activity.steps);
      } catch (e) {
        stepList = activity.steps ? activity.steps.split('\n').filter(s => s.trim().length > 0).map(s => ({ text: s, image: '' })) : [];
      }
    %>

    <% if (stepList.length > 0) { %>
      <div class="space-y-8">
        <% stepList.forEach((step, index) => { %>
          <div class="bg-indigo-50/40 border-2 border-indigo-100 rounded-2xl p-6 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            
            <% if (step.image) { %>
              <div class="w-full md:w-3/5 rounded-2xl overflow-hidden border border-slate-200 shadow-md bg-white">
                <img src="<%= step.image %>" alt="Passo <%= index + 1 %>" class="w-full h-auto max-h-[420px] object-cover">
              </div>
            <% } %>

            <div class="flex-1 space-y-3">
              <div class="bg-indigo-600 text-white font-black text-sm px-4 py-1.5 rounded-xl shadow-sm inline-block">
                Passo <%= index + 1 %>
              </div>
              <p class="text-slate-800 text-xl font-medium leading-relaxed">
                <%= step.text %>
              </p>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</article>

<%- include('partials/footer') %>
