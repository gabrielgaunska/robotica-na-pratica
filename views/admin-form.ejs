<%- include('partials/header') %>

<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6">
  <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6 text-white">
      <h1 class="text-3xl font-extrabold flex items-center gap-3">
        <span>🤖</span> <%= activity ? 'Editar Atividade' : 'Criar Atividade' %>
      </h1>
      <p class="text-blue-100 mt-1">Insira os materiais e imagens em cada passo de montagem!</p>
    </div>

    <form action="<%= activity ? '/admin/edit/' + activity.id : '/admin/new' %>" method="POST" enctype="multipart/form-data" class="p-8 space-y-8">
      
      <!-- Dados Básicos -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">🏷️ Título</label>
          <input type="text" name="title" value="<%= activity ? activity.title : '' %>" required class="w-full border border-slate-200 rounded-2xl px-4 py-3 outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500 transition">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">🎯 Categoria</label>
          <input type="text" name="category" value="<%= activity ? activity.category : '' %>" required class="w-full border border-slate-200 rounded-2xl px-4 py-3 outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500 transition">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">👥 Faixa Etária</label>
          <input type="text" name="age_range" value="<%= activity ? activity.age_range : '' %>" class="w-full border border-slate-200 rounded-2xl px-4 py-3 outline-none">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">⏱️ Tempo Estimado</label>
          <input type="text" name="duration" value="<%= activity ? activity.duration : '' %>" class="w-full border border-slate-200 rounded-2xl px-4 py-3 outline-none">
        </div>
      </div>

      <!-- Imagem de Capa -->
      <div class="border-2 border-dashed border-slate-200 rounded-3xl p-6 bg-slate-50 flex flex-col items-center text-center">
        <span class="text-3xl mb-1">📸</span>
        <label class="block text-sm font-bold text-slate-700 mb-1">Capa Principal</label>
        <input type="file" name="image" class="mt-2 text-sm text-slate-500 file:py-2 file:px-4 file:rounded-full file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
        <% if (activity && activity.image) { %>
          <input type="hidden" name="current_image" value="<%= activity.image %>">
          <p class="text-xs text-slate-500 mt-2">Imagem cadastrada: <%= activity.image %></p>
        <% } %>
      </div>

      <!-- Descrição -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">📝 Objetivo Pedagógico</label>
        <textarea name="description" required rows="3" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 outline-none"><%= activity ? activity.description : '' %></textarea>
      </div>

      <!-- Materiais -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">📦 Materiais Necessários (um por linha)</label>
        <textarea name="materials" required rows="4" class="w-full border border-slate-200 rounded-2xl px-4 py-3 font-mono text-sm focus:ring-4 focus:ring-blue-100 outline-none"><%= activity ? activity.materials : '' %></textarea>
      </div>

      <!-- Passos Dinâmicos com Imagens por Passo -->
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <label class="block text-sm font-bold text-slate-700">🛠️ Etapas do Projeto</label>
          <button type="button" id="add-step-btn" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-4 py-2 rounded-2xl text-sm font-bold transition">
            ➕ Adicionar Passo
          </button>
        </div>
        
        <div id="steps-container" class="space-y-4">
          <!-- Passos renderizados dinamicamente -->
        </div>
        <input type="hidden" id="steps-hidden" name="steps">
      </div>

      <!-- Segurança -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">⚠️ Dicas de Segurança (Opcional)</label>
        <textarea name="safety" rows="2" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 outline-none"><%= activity ? activity.safety : '' %></textarea>
      </div>

      <div class="flex gap-4 pt-4 border-t border-slate-100">
        <button type="submit" onclick="prepareSubmit()" class="flex-grow bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold py-4 px-6 rounded-2xl shadow-lg transition">
          💾 Salvar Atividade
        </button>
        <a href="/admin" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-4 px-6 rounded-2xl text-center">Cancelar</a>
      </div>

    </form>
  </div>
</div>

<script>
  const stepsContainer = document.getElementById('steps-container');
  const addStepBtn = document.getElementById('add-step-btn');
  const stepsHidden = document.getElementById('steps-hidden');

  const rawSteps = `<%= activity ? activity.steps : '' %>`;
  const rawStepImages = `<%= activity && activity.step_images ? activity.step_images : '' %>`;
  
  function createStepElement(num, value = '', imgValue = '') {
    const div = document.createElement('div');
    div.className = 'step-item bg-slate-50 border border-slate-200 p-6 rounded-2xl flex flex-col gap-4 transition hover:border-indigo-300';
    div.innerHTML = `
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="step-number bg-indigo-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shrink-0">${num}</span>
          <h4 class="font-bold text-slate-800">Passo ${num}</h4>
        </div>
        <button type="button" onclick="removeStep(this)" class="text-red-500 hover:text-red-700 text-sm font-medium transition">🗑️ Remover</button>
      </div>
      <div class="space-y-3">
        <textarea class="step-text w-full border border-slate-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-200 outline-none resize-none" rows="2" placeholder="Descreva esta etapa...">${value}</textarea>
        
        <div class="bg-white p-3 rounded-xl border border-slate-150">
          <label class="block text-xs font-bold text-slate-500 uppercase mb-2">📸 Imagem do Passo</label>
          <input type="file" name="step_image_${num-1}" class="text-sm text-slate-500 file:py-1 file:px-3 file:rounded-full file:border-0 file:bg-slate-100 hover:file:bg-slate-200">
          ${imgValue ? `
            <input type="hidden" name="current_step_image_${num-1}" value="${imgValue}">
            <div class="mt-2 flex items-center gap-2 bg-slate-50 p-2 rounded-lg border border-slate-100">
              <img src="${imgValue}" class="w-12 h-12 object-cover rounded-md">
              <span class="text-xs text-slate-500 font-mono">Imagem adicionada</span>
            </div>
          ` : ''}
        </div>
      </div>
    `;
    stepsContainer.appendChild(div);
  }

  function reorderSteps() {
    const items = stepsContainer.querySelectorAll('.step-item');
    items.forEach((item, index) => {
      item.querySelector('.step-number').innerText = index + 1;
      item.querySelector('h4').innerText = "Passo " + (index + 1);
      
      const fileInput = item.querySelector('input[type="file"]');
      if (fileInput) fileInput.setAttribute('name', `step_image_${index}`);
      
      const hiddenInput = item.querySelector('input[type="hidden"]');
      if (hiddenInput) hiddenInput.setAttribute('name', `current_step_image_${index}`);
    });
  }

  function removeStep(button) {
    button.closest('.step-item').remove();
    reorderSteps();
  }

  addStepBtn.addEventListener('click', () => {
    const nextNum = stepsContainer.querySelectorAll('.step-item').length + 1;
    createStepElement(nextNum);
  });

  if (rawSteps.trim() !== '') {
    const stepsArray = rawSteps.split('|||');
    const imagesArray = rawStepImages.trim() !== '' ? rawStepImages.split('|||') : [];
    stepsArray.forEach((step, idx) => {
      createStepElement(idx + 1, step, imagesArray[idx] || '');
    });
  } else {
    createStepElement(1);
  }

  function prepareSubmit() {
    const textareas = stepsContainer.querySelectorAll('.step-text');
    const stepsValues = Array.from(textareas).map(ta => ta.value.trim()).filter(val => val !== '');
    stepsHidden.value = stepsValues.join('|||');
  }
</script>

<%- include('partials/footer') %>
