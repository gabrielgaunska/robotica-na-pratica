<%- include('partials/header') %>
<div class="max-w-3xl mx-auto bg-white p-6 sm:p-8 rounded-2xl shadow-lg border border-slate-200">
  <h1 class="text-2xl font-bold text-slate-800 mb-6"><%= activity ? '✏️ Editar Atividade' : '➕ Nova Atividade' %></h1>
  
  <form action="<%= activity ? '/admin/edit/' + activity.id : '/admin/new' %>" method="POST" enctype="multipart/form-data" class="space-y-5">
    <% if (activity) { %> <input type="hidden" name="current_image" value="<%= activity.image %>"> <% } %>
    
    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Título da Atividade *</label>
      <input type="text" name="title" required value="<%= activity ? activity.title : '' %>" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500">
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1">Categoria *</label>
        <input type="text" name="category" required placeholder="Ex: Robótica, Elétrica" value="<%= activity ? activity.category : '' %>" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1">Faixa Etária</label>
        <input type="text" name="age_range" placeholder="Ex: 6 a 10 anos" value="<%= activity ? activity.age_range : '' %>" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1">Duração</label>
        <input type="text" name="duration" placeholder="Ex: 45 min" value="<%= activity ? activity.duration : '' %>" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500">
      </div>
    </div>

    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Descrição e Objetivo *</label>
      <textarea name="description" required rows="3" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500"><%= activity ? activity.description : '' %></textarea>
    </div>

    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Materiais Necessários *</label>
      <textarea name="materials" required rows="3" placeholder="- 1 Motor DC&#10;- 2 Pilhas AA" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500"><%= activity ? activity.materials : '' %></textarea>
    </div>

    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Passo a Passo Detalhado *</label>
      <textarea name="steps" required rows="6" placeholder="Passo 1: Conecte os fios..." class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500"><%= activity ? activity.steps : '' %></textarea>
    </div>

    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Instruções de Segurança (Opcional)</label>
      <textarea name="safety" rows="2" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500"><%= activity ? activity.safety : '' %></textarea>
    </div>

    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Imagem de Capa / Projeto</label>
      <input type="file" name="image" accept="image/*" class="w-full border rounded-lg p-2 bg-slate-50">
    </div>

    <div class="flex justify-end gap-3 pt-4 border-t">
      <a href="/admin" class="bg-slate-300 hover:bg-slate-400 text-slate-800 font-bold px-4 py-2.5 rounded-lg">Cancelar</a>
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-lg">Salvar Atividade</button>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
