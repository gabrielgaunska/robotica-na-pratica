<%- include('partials/header') %>

<div class="max-w-2xl mx-auto bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-100">
  <h1 class="text-2xl font-bold text-slate-800 mb-6"><%= activity ? '✏️ Editar Atividade' : '🤖 Cadastrar Nova Atividade' %></h1>
  
  <form action="<%= activity ? '/admin/edit/' + activity.id : '/admin/new' %>" method="POST" enctype="multipart/form-data" class="space-y-5">
    
    <% if (activity && activity.image) { %>
      <input type="hidden" name="current_image" value="<%= activity.image %>">
    <% } %>

    <div>
      <label class="block text-slate-700 font-bold mb-2">Título do Projeto:</label>
      <input type="text" name="title" required value="<%= activity ? activity.title : '' %>" class="w-full px-4 py-2 border border-slate-300 rounded-xl">
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-slate-700 font-bold mb-2">Categoria:</label>
        <input type="text" name="category" required value="<%= activity ? activity.category : '' %>" placeholder="Ex: Eletrônica" class="w-full px-4 py-2 border border-slate-300 rounded-xl">
      </div>
      <div>
        <label class="block text-slate-700 font-bold mb-2">Faixa Etária:</label>
        <input type="text" name="age_range" value="<%= activity ? activity.age_range : '' %>" placeholder="Ex: 8 a 12 anos" class="w-full px-4 py-2 border border-slate-300 rounded-xl">
      </div>
      <div>
        <label class="block text-slate-700 font-bold mb-2">Duração (Minutos):</label>
        <input type="text" name="duration" value="<%= activity ? activity.duration : '' %>" placeholder="Ex: 45 min" class="w-full px-4 py-2 border border-slate-300 rounded-xl">
      </div>
    </div>

    <div>
      <label class="block text-slate-700 font-bold mb-2">Resumo da Atividade:</label>
      <textarea name="description" rows="3" required class="w-full px-4 py-2 border border-slate-300 rounded-xl"><%= activity ? activity.description : '' %></textarea>
    </div>

    <div>
      <label class="block text-slate-700 font-bold mb-2">Materiais Necessários (um por linha):</label>
      <textarea name="materials" rows="4" required placeholder="Ex: 1 Placa Arduino&#10;3 Leds&#10;Cabos jumper" class="w-full px-4 py-2 border border-slate-300 rounded-xl"><%= activity ? activity.materials : '' %></textarea>
    </div>

    <div>
      <label class="block text-slate-700 font-bold mb-2">Instruções de Montagem (uma etapa por linha):</label>
      <textarea name="steps" rows="5" required placeholder="Ex: Conecte o Led no pino 13&#10;Ligue o cabo USB no computador&#10;Envie o código" class="w-full px-4 py-2 border border-slate-300 rounded-xl"><%= activity ? activity.steps : '' %></textarea>
    </div>

    <div>
      <label class="block text-slate-700 font-bold mb-2">Dicas de Segurança (Opcional):</label>
      <textarea name="safety" rows="2" class="w-full px-4 py-2 border border-slate-300 rounded-xl"><%= activity ? activity.safety : '' %></textarea>
    </div>

    <div>
      <label class="block text-slate-700 font-bold mb-2">Imagem de Capa / Projeto:</label>
      <input type="file" name="image" class="w-full text-slate-600">
    </div>

    <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
      <a href="/admin" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-6 py-2.5 rounded-xl transition">Cancelar</a>
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-xl transition">Salvar Projeto</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
