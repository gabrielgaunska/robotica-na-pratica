<%- include('partials/header') %>
<div class="max-w-3xl mx-auto py-12 px-4">
  <h1 class="text-3xl font-bold mb-8"><%= activity ? 'Editar Atividade' : 'Nova Atividade' %></h1>
  <form action="<%= activity ? '/admin/edit/' + activity.id : '/admin/new' %>" method="POST" enctype="multipart/form-data" class="space-y-6 bg-white p-8 border border-slate-200 rounded-2xl shadow-sm">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-sm font-semibold mb-1">Título</label>
        <input type="text" name="title" value="<%= activity ? activity.title : '' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2">
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1">Categoria</label>
        <input type="text" name="category" value="<%= activity ? activity.category : '' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2">
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1">Faixa Etária</label>
        <input type="text" name="age_range" value="<%= activity ? activity.age_range : '' %>" class="w-full border border-slate-300 rounded-lg px-3 py-2">
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1">Tempo de Execução</label>
        <input type="text" name="duration" value="<%= activity ? activity.duration : '' %>" class="w-full border border-slate-300 rounded-lg px-3 py-2">
      </div>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Breve Descrição</label>
      <textarea name="description" required class="w-full border border-slate-300 rounded-lg px-3 py-2" rows="3"><%= activity ? activity.description : '' %></textarea>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Materiais Necessários</label>
      <textarea name="materials" required class="w-full border border-slate-300 rounded-lg px-3 py-2" rows="3"><%= activity ? activity.materials : '' %></textarea>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Instruções Passo a Passo</label>
      <textarea name="steps" required class="w-full border border-slate-300 rounded-lg px-3 py-2" rows="5"><%= activity ? activity.steps : '' %></textarea>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Dicas de Segurança</label>
      <textarea name="safety" class="w-full border border-slate-300 rounded-lg px-3 py-2" rows="2"><%= activity ? activity.safety : '' %></textarea>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Imagem Ilustrativa</label>
      <input type="file" name="image" class="w-full">
      <% if (activity && activity.image) { %>
        <input type="hidden" name="current_image" value="<%= activity.image %>">
        <p class="text-xs text-slate-500 mt-2">Imagem atual: <%= activity.image %></p>
      <% } %>
    </div>
    <div class="flex gap-4">
      <button type="submit" class="bg-blue-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-blue-700">Salvar</button>
      <a href="/admin" class="bg-slate-100 text-slate-700 font-semibold py-2 px-6 rounded-lg hover:bg-slate-200">Cancelar</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
