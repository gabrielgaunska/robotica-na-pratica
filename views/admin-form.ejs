<%- include('partials/header') %>

<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6">
  <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
    <!-- Cabeçalho do formulário -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6 text-white">
      <h1 class="text-3xl font-extrabold flex items-center gap-3">
        <span>🚀</span> <%= activity ? 'Editar Atividade' : 'Criar Nova Atividade' %>
      </h1>
      <p class="text-blue-100 mt-1">Preencha os detalhes para publicar uma atividade incrível de robótica!</p>
    </div>

    <form action="<%= activity ? '/admin/edit/' + activity.id : '/admin/new' %>" method="POST" enctype="multipart/form-data" class="p-8 space-y-8">
      
      <!-- Dados Básicos -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">🏷️ Título da Atividade</label>
          <input type="text" name="title" value="<%= activity ? activity.title : '' %>" required placeholder="Ex: Robô Desenhista com Copo" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">🎯 Categoria / Nível</label>
          <input type="text" name="category" value="<%= activity ? activity.category : '' %>" required placeholder="Ex: Iniciante, Reciclagem, Eletrônica" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">👥 Faixa Etária Recomendada</label>
          <input type="text" name="age_range" value="<%= activity ? activity.age_range : '' %>" placeholder="Ex: 7 a 12 anos" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">⏱️ Tempo Estimado</label>
          <input type="text" name="duration" value="<%= activity ? activity.duration : '' %>" placeholder="Ex: 45 minutos" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition">
        </div>
      </div>

      <!-- Imagem de Capa -->
      <div class="border-2 border-dashed border-slate-200 rounded-3xl p-6 bg-slate-50 flex flex-col items-center justify-center text-center">
        <span class="text-4xl mb-2">📸</span>
        <label class="block text-sm font-bold text-slate-700 mb-1">Imagem de Capa do Projeto</label>
        <input type="file" name="image" class="mt-2 text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
        <% if (activity && activity.image) { %>
          <input type="hidden" name="current_image" value="<%= activity.image %>">
          <p class="text-xs text-slate-500 mt-2">Imagem cadastrada: <%= activity.image %></p>
        <% } %>
      </div>

      <!-- Descrição -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">📝 Descrição e Objetivo Pedagógico</label>
        <textarea name="description" required rows="3" placeholder="O que as crianças vão aprender e construir com esta atividade?" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition"><%= activity ? activity.description : '' %></textarea>
      </div>

      <!-- Materiais -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">📦 Materiais Necessários (um por linha)</label>
        <textarea name="materials" required rows="4" placeholder="Ex:&#10;- 1 Copo descartável&#10;- 1 Motor de vibração&#10;- 1 Pilha AA" class="w-full border border-slate-200 rounded-2xl px-4 py-3 font-mono text-sm focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition"><%= activity ? activity.materials : '' %></textarea>
      </div>

      <!-- Instruções Passo a Passo Dinâmicas -->
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <label class="block text-sm font-bold text-slate-700">🛠️ Passos de Montagem</label>
          <button type="button" id="add-step-btn" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-4 py-2 rounded-2xl text-sm font-bold transition flex items-center gap-1">
            ➕ Adicionar Passo
          </button>
        </div>
        
        <!-- Container dos Passos -->
        <div id="steps-container" class="space-y-4">
          <!-- Os passos salvos serão carregados aqui ou um passo inicial se for novo -->
        </div>
        
        <!-- Campo oculto para enviar as etapas unificadas -->
        <input type="hidden" id="steps-hidden" name="steps">
      </div>

      <!-- Segurança -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">⚠️ Instruções de Segurança (Opcional)</label>
        <textarea name="safety" rows="2" placeholder="Ex: Peça ajuda a um adulto para usar a cola quente!" class="w-full border border-slate-200 rounded-2xl px-4 py-3 focus:ring-4 focus:ring-blue-100 focus:border-blue-500 outline-none transition"><%= activity ? activity.safety : '' %></textarea>
      </div>

      <!-- Botões de Ação -->
      <div class="flex gap-4 pt-4 border-t border-slate-100">
        <button type="submit" onclick="prepareSubmit()" class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-extrabold py-4 px-6 rounded-2xl shadow-lg transition transform hover:-translate-y-0.5">
          💾 Salvar Atividade
        </button>
        <a href="/admin" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-4 px-6 rounded-2xl transition text-center">
          Cancelar
        </a>
      </div>

    </form>
  </div>
</div>

<script>
  const stepsContainer = document.getElementById('steps-container');
  const addStepBtn = document.getElementById('add-step-btn');
  const stepsHidden = document.getElementById('steps-hidden');

  // Recupera passos existentes se for edição, senão começa vazio ou com 1 passo
  const rawSteps = `<%= activity ? activity.steps : '' %>`;
  
  function createStepElement(num, value = '') {
    const div = document.createElement('div');
    div.className = 'step-item bg-slate-50 border border-slate-200 p-4 rounded-2xl flex items-start gap-4 transition hover:border-indigo-300';
    div.innerHTML = `
      <span class="step-number bg-indigo-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shrink-0 mt-1">${num}</span>
      <div class="flex-grow space-y-3">
        <textarea class="step-text w-full border border-slate-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-200 outline-none resize-none" rows="2" placeholder="Descreva esta etapa...">${value}</textarea>
      </div>
      <button type="button" onclick="removeStep(this)" class="text-red-500 hover:text-red-700 p-2 text-lg transition">🗑️</button>
    `;
    stepsContainer.appendChild(div);
  }

  function reorderSteps() {
    const items = stepsContainer.querySelectorAll('.step-item');
    items.forEach((item, index) => {
      item.querySelector('.step-number').innerText = index + 1;
    });
  }

  function removeStep(button) {
    button.closest('.step-item').remove();
    reorderSteps();
  }

  addStepBtn.addEventListener('click', () => {
    const nextNum = stepsContainer.querySelectorAll('.step-item').length + 1;
    createStepElement(nextNum);
  });

  // Inicializar com dados salvos ou criar um passo vazio
  if (rawSteps.trim() !== '') {
    const stepsArray = rawSteps.split('|||');
    stepsArray.forEach((step, idx) => {
      createStepElement(idx + 1, step);
    });
  } else {
    createStepElement(1);
  }

  // Prepara o envio unificando os passos em uma única string usando o separador |||
  function prepareSubmit() {
    const textareas = stepsContainer.querySelectorAll('.step-text');
    const stepsValues = Array.from(textareas).map(ta => ta.value.trim()).filter(val => val !== '');
    stepsHidden.value = stepsValues.join('|||');
  }
</script>

<%- include('partials/footer') %>
