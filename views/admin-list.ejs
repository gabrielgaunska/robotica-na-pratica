<%- include('partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-12">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Painel de Atividades</h1>
    <div class="flex gap-2">
      <a href="/admin/new" class="bg-blue-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-blue-700">Nova Atividade</a>
      <a href="/admin/logout" class="bg-slate-200 text-slate-700 px-4 py-2 rounded-lg font-semibold hover:bg-slate-300">Sair</a>
    </div>
  </div>
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
    <table class="w-full text-left">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-4 font-semibold">Título</th>
          <th class="p-4 font-semibold">Categoria</th>
          <th class="p-4 font-semibold text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% activities.forEach(function(act) { %>
          <tr>
            <td class="p-4 font-medium"><%= act.title %></td>
            <td class="p-4 text-slate-500"><%= act.category %></td>
            <td class="p-4 text-right flex justify-end gap-2">
              <a href="/admin/edit/<%= act.id %>" class="bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1 rounded text-sm font-medium">Editar</a>
              <form action="/admin/delete/<%= act.id %>" method="POST" onsubmit="return confirm('Deseja excluir esta atividade?')">
                <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-3 py-1 rounded text-sm font-medium">Excluir</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
