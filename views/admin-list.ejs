<%- include('partials/header') %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-extrabold text-slate-900">Gerenciar Atividades</h1>
  <a href="/admin/new" class="bg-green-500 hover:bg-green-600 text-white font-bold px-4 py-2 rounded-xl text-sm transition">+ Criar Atividade</a>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="bg-slate-50 border-b border-slate-100 text-slate-600 text-sm font-semibold">
        <th class="p-4">Projeto</th>
        <th class="p-4">Categoria</th>
        <th class="p-4">Ações</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
      <% if (activities.length === 0) { %>
        <tr>
          <td colspan="3" class="p-4 text-center text-slate-500">Nenhum projeto cadastrado ainda.</td>
        </tr>
      <% } %>
      <% activities.forEach(activity => { %>
        <tr>
          <td class="p-4 font-bold text-indigo-900"><%= activity.title %></td>
          <td class="p-4"><%= activity.category %></td>
          <td class="p-4 flex gap-2">
            <a href="/admin/edit/<%= activity.id %>" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold">Editar</a>
            <form action="/admin/delete/<%= activity.id %>" method="POST" onsubmit="return confirm('Deseja mesmo excluir?')">
              <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
