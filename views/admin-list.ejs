<%- include('partials/header') %>

<div class="flex justify-between items-center mb-8">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Painel Administrativo</h1>
    <p class="text-slate-600">Gerencie as atividades do portal</p>
  </div>
  <a href="/admin/new" class="bg-indigo-600 text-white font-bold px-5 py-2.5 rounded-xl hover:bg-indigo-700 transition">
    + Nova Atividade
  </a>
</div>

<% if (activities.length === 0) { %>
  <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-300">
    <p class="text-slate-500 text-lg">Nenhuma atividade cadastrada ainda.</p>
  </div>
<% } else { %>
  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-100 text-slate-700 text-sm border-b border-slate-200">
          <th class="p-4">Imagem</th>
          <th class="p-4">Título</th>
          <th class="p-4">Categoria</th>
          <th class="p-4 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% activities.forEach(act => { %>
          <tr class="hover:bg-slate-50">
            <td class="p-4 w-20">
              <% if (act.image) { %>
                <img src="<%= act.image %>" class="w-12 h-12 object-cover rounded-lg">
              <% } else { %>
                <div class="w-12 h-12 bg-slate-200 rounded-lg flex items-center justify-center text-xs text-slate-500">Sem foto</div>
              <% } %>
            </td>
            <td class="p-4 font-bold text-slate-800"><%= act.title %></td>
            <td class="p-4"><span class="text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded-full"><%= act.category %></span></td>
            <td class="p-4 text-right flex justify-end gap-2">
              <a href="/admin/edit/<%= act.id %>" class="bg-amber-500 text-white text-xs font-bold px-3 py-2 rounded-lg hover:bg-amber-600 transition">Editar</a>
              <form action="/admin/delete/<%= act.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir esta atividade?');" class="inline">
                <button type="submit" class="bg-red-500 text-white text-xs font-bold px-3 py-2 rounded-lg hover:bg-red-600 transition">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
