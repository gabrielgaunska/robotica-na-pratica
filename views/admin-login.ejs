<%- include('partials/header') %>

<div class="max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 p-8 my-12">
  <h1 class="text-2xl font-extrabold text-slate-900 text-center mb-6">Área do Professor / Admin</h1>
  
  <% if (error) { %>
    <div class="bg-red-50 text-red-600 border border-red-200 p-3 rounded-xl mb-4 text-sm font-semibold text-center">
      <%= error %>
    </div>
  <% } %>

  <form action="/admin/login" method="POST" class="space-y-4">
    <div>
      <label class="block text-sm font-bold text-slate-700 mb-1">Senha de Acesso</label>
      <input type="password" name="password" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition">
      Entrar
    </button>
  </form>
</div>

<%- include('partials/footer') %>
