<%- include('partials/header') %>
<div class="max-w-md mx-auto my-12 bg-white p-8 rounded-2xl shadow-lg border border-slate-200">
  <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">🔐 Acesso Administrativo</h2>
  <% if (error) { %>
    <div class="bg-red-100 text-red-700 p-3 rounded-lg text-sm mb-4 border border-red-200"><%= error %></div>
  <% } %>
  <form action="/admin/login" method="POST" class="space-y-5">
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">Senha de Acesso</label>
      <input type="password" name="password" required placeholder="Digite a senha..." class="w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg font-bold hover:bg-indigo-700 transition">Entrar no Painel</button>
  </form>
</div>
<%- include('partials/footer') %>
