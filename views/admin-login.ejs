<%- include('partials/header') %>
<div class="max-w-md mx-auto my-20 p-6 bg-white border border-slate-200 rounded-2xl shadow-sm">
  <h2 class="text-2xl font-bold mb-4 text-center">Login Administrativo</h2>
  <% if (error) { %>
    <p class="text-red-500 mb-4 text-center text-sm bg-red-50 p-2 rounded-lg"><%= error %></p>
  <% } %>
  <form action="/admin/login" method="POST" class="space-y-4">
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1">Senha de Acesso</label>
      <input type="password" name="password" required class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
    </div>
    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded-lg transition">Entrar</button>
  </form>
</div>
<%- include('partials/footer') %>
