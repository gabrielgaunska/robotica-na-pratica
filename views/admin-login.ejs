<%- include('partials/header') %>

<div class="max-w-md mx-auto my-12">
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
    <div class="text-center mb-6">
      <span class="text-4xl">🔐</span>
      <h2 class="text-2xl font-bold text-gray-900 mt-2">Área do Professor</h2>
      <p class="text-gray-500 text-sm mt-1">Insira a senha para gerenciar as atividades</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 text-red-700 p-3 rounded-lg text-sm mb-4 text-center font-medium">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Senha de Acesso</label>
        <input type="password" id="password" name="password" required placeholder="Digite a senha..." class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 border p-2.5">
      </div>
      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg shadow-sm transition-colors">
        Entrar no Painel
      </button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
