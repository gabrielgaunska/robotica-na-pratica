<%- include('partials/header') %>

<div class="max-w-md mx-auto bg-white p-8 rounded-3xl shadow-sm border border-slate-100 my-10">
  <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">🔐 Área do Professor</h2>
  
  <% if (error) { %>
    <div class="bg-red-50 text-red-600 text-sm p-4 rounded-xl border border-red-100 mb-4">
      <%= error %>
    </div>
  <% } %>
  
  <form action="/admin/login" method="POST" class="space-y-4">
    <div>
      <label class="block text-slate-700 font-semibold mb-2">Digite a Senha de Acesso:</label>
      <input type="password" name="password" required class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-xl transition">Entrar</button>
  </form>
</div>

<%- include('partials/footer') %>
