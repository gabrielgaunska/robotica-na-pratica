<%- include('partials/header') %>

<div class="text-center py-10 bg-white rounded-3xl shadow-sm border border-slate-100 mb-8 p-6">
  <h1 class="text-4xl sm:text-5xl font-extrabold text-indigo-900 tracking-tight mb-4">
    Robótica na Prática
  </h1>
  <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-6">
    Acesse atividades educacionais passo a passo de robótica e eletrônica criativa, pensadas especialmente para inspirar crianças e jovens inventores!
  </p>
  
  <form action="/" method="GET" class="max-w-md mx-auto flex gap-2">
    <input type="text" name="search" placeholder="Buscar projeto ou material..." value="<%= search %>" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-2 rounded-xl transition">Buscar</button>
  </form>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if (activities.length === 0) { %>
    <div class="col-span-full text-center py-12">
      <p class="text-slate-500 text-lg">Nenhuma atividade cadastrada ou encontrada.</p>
    </div>
  <% } %>
  
  <% activities.forEach(activity => { %>
    <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition border border-slate-100 flex flex-col h-full">
      <div class="h-48 bg-slate-100 relative">
        <% if (activity.image) { %>
          <img src="<%= activity.image %>" class="w-full h-full object-cover" alt="<%= activity.title %>">
        <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-slate-400 text-5xl">🤖</div>
        <% } %>
        <span class="absolute top-3 left-3 bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-full"><%= activity.category %></span>
      </div>
      <div class="p-5 flex-grow flex flex-col justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-800 mb-2"><%= activity.title %></h2>
          <p class="text-slate-600 text-sm line-clamp-3 mb-4"><%= activity.description %></p>
        </div>
        
        <div class="border-t border-slate-100 pt-4 flex justify-between items-center text-xs text-slate-500">
          <span>👶 <%= activity.age_range || 'Livre' %></span>
          <span>⏱️ <%= activity.duration || 'Variado' %></span>
          <a href="/activity/<%= activity.id %>" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-4 py-2 rounded-lg transition text-xs">Começar →</a>
        </div>
      </div>
    </div>
  <% %>
  <% }) %>
</div>

<%- include('partials/footer') %>
