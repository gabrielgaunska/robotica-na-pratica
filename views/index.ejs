<%- include('partials/header') %>

<section class="text-center py-8 bg-white rounded-2xl shadow-sm border border-slate-200 mb-8 p-6">
  <h1 class="text-4xl font-extrabold text-slate-900 mb-3">Robótica na Prática 🤖</h1>
  <p class="text-lg text-slate-600 max-w-2xl mx-auto">
    Explore atividades práticas de robótica educacional com passo a passo ilustrado para ensinar e aprender de forma divertida.
  </p>
</section>

<div class="flex flex-wrap md:flex-nowrap gap-6 mb-8">
  <form action="/" method="GET" class="w-full flex gap-2">
    <input 
      type="text" 
      name="search" 
      placeholder="Pesquisar atividade..." 
      value="<%= search %>"
      class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm"
    >
    <button type="submit" class="bg-indigo-600 text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-indigo-700 transition">
      Buscar
    </button>
  </form>
</div>

<% if (activities.length === 0) { %>
  <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-300">
    <p class="text-slate-500 text-lg">Nenhuma atividade encontrada no momento.</p>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% activities.forEach(act => { %>
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col hover:shadow-md transition">
        <% if (act.image) { %>
          <img src="<%= act.image %>" alt="<%= act.title %>" class="w-full h-48 object-cover">
        <% } else { %>
          <div class="w-full h-48 bg-indigo-50 flex items-center justify-center text-indigo-300 text-5xl font-bold">🤖</div>
        <% } %>
        <div class="p-5 flex flex-col flex-grow">
          <span class="inline-block self-start text-xs font-bold px-2.5 py-1 bg-indigo-100 text-indigo-700 rounded-full mb-2">
            <%= act.category %>
          </span>
          <h2 class="text-xl font-bold text-slate-900 mb-2"><%= act.title %></h2>
          <p class="text-slate-600 text-sm mb-4 line-clamp-3 flex-grow"><%= act.description %></p>
          <a href="/activity/<%= act.id %>" class="block text-center bg-indigo-50 text-indigo-600 font-bold py-2 rounded-xl hover:bg-indigo-600 hover:text-white transition">
            Ver Atividade Completa →
          </a>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
