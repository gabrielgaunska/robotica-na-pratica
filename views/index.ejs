<%- include('partials/header') %>
<div class="text-center py-8 mb-8 bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
  <h1 class="text-3xl sm:text-4xl font-extrabold text-indigo-900 mb-3">Robótica na Prática</h1>
  <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto">Acesse atividades educacionais passo a passo, pensadas especialmente para inspirar crianças e jovens inventores.</p>
</div>

<% if (activities.length === 0) { %>
  <div class="text-center py-12 bg-white rounded-xl border border-slate-200">
    <p class="text-slate-500 text-lg">Nenhuma atividade cadastrada no momento.</p>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% activities.forEach(act => { %>
      <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-slate-200 flex flex-col hover:shadow-lg transition">
        <% if (act.image) { %>
          <img src="<%= act.image %>" alt="<%= act.title %>" class="w-full h-52 object-cover">
        <% } else { %>
          <div class="w-full h-52 bg-indigo-100 flex items-center justify-center text-indigo-400 font-bold text-lg">Sem Imagem</div>
        <% } %>
        <div class="p-5 flex-grow flex flex-col justify-between">
          <div>
            <span class="inline-block bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider mb-2"><%= act.category %></span>
            <h3 class="text-xl font-bold text-slate-800 mb-2"><%= act.title %></h3>
            <p class="text-slate-600 text-sm line-clamp-3 mb-4"><%= act.description %></p>
          </div>
          <a href="/activity/<%= act.id %>" class="block text-center bg-indigo-600 text-white font-semibold py-2.5 rounded-lg hover:bg-indigo-700 transition">Ver Atividade Completa →</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
