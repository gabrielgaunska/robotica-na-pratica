<%- include('partials/header') %>

<main class="flex-grow max-w-7xl mx-auto px-4 py-8 w-full">
  <!-- Banner Principal -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 mb-8 text-center">
    <h1 class="text-4xl font-black text-indigo-900 mb-3">Robótica na Prática</h1>
    <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
      Feito com muito carinho para os alunos do 4º e 5º anos, este espaço foi criado para despertar a curiosidade, estimular a criatividade e transformar o aprendizado em uma aventura pelo mundo da robótica!
    </p>
  </div>

  <!-- Barra de Pesquisa e Filtros -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
    <form action="/" method="GET" class="flex flex-col md:flex-row gap-4 items-center justify-between">
      <div class="w-full md:w-2/3 flex gap-2">
        <input 
          type="text" 
          name="search" 
          value="<%= locals.search || '' %>" 
          placeholder="Pesquisar atividades..." 
          class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl font-semibold transition">
          Buscar
        </button>
      </div>
      <% if (locals.isAdmin) { %>
        <div class="w-full md:w-auto flex justify-end">
          <a href="/admin/new" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl font-semibold transition flex items-center gap-2">
            ➕ Nova Atividade
          </a>
        </div>
      <% } %>
    </form>
  </div>

  <!-- Lista de Atividades -->
  <% if (activities && activities.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% activities.forEach(activity => { %>
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col hover:shadow-md transition">
          <% if (activity.image) { %>
            <img src="<%= activity.image %>" alt="<%= activity.title %>" class="w-full h-48 object-cover">
          <% } else { %>
            <div class="w-full h-48 bg-slate-100 flex items-center justify-center text-slate-400 font-medium">Sem imagem</div>
          <% } %>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full w-max mb-3">
              <%= activity.category %>
            </span>
            <h3 class="text-xl font-bold text-slate-900 mb-2"><%= activity.title %></h3>
            <p class="text-slate-600 text-sm mb-4 line-clamp-3 flex-grow"><%= activity.description %></p>
            <div class="flex items-center justify-between text-xs text-slate-500 border-t border-slate-100 pt-4 mt-auto">
              <span><%= activity.age_range || 'Livre' %></span>
              <span><%= activity.duration || '-' %></span>
            </div>
            <a href="/activity/<%= activity.id %>" class="mt-4 block text-center bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2.5 rounded-xl transition">
              Ver Atividade Completa
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center text-slate-500">
      <p class="text-lg">Nenhuma atividade cadastrada no momento.</p>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
