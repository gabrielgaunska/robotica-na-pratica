<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Robótica na Prática</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">
  <header class="bg-indigo-600 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center">
      <a href="/" class="text-2xl font-black tracking-wide flex items-center gap-2">
        🤖 Robótica na Prática
      </a>
      <nav class="flex items-center gap-4 mt-2 sm:mt-0">
        <a href="/" class="hover:underline font-medium">Início</a>
        <% if (locals.isAdmin) { %>
          <a href="/admin" class="bg-indigo-800 hover:bg-indigo-900 px-3 py-1.5 rounded-lg text-sm font-semibold transition">Painel Admin</a>
          <a href="/admin/logout" class="bg-red-500 hover:bg-red-600 px-3 py-1.5 rounded-lg text-sm font-semibold transition">Sair</a>
        <% } else { %>
          <a href="/admin/login" class="bg-indigo-500 hover:bg-indigo-700 px-3 py-1.5 rounded-lg text-sm font-semibold transition">Área do Professor</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8">
